<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only at the OS level: cleartext (http) traffic is not permitted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
